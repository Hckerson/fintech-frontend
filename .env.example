NEXT_PUBLIC_API_URL=http://localhost:4101

# JWT — RS256 verification only. Generate the pair in the backend with
# `pnpm keys:generate` and paste the public half here.
# The proxy verifies and never signs, so it must never hold JWT_PRIVATE_KEY.
JWT_PUBLIC_KEY=

# Money movement (payees, transfers). Server-only. Off unless exactly "on";
# while off, /payments answers 404 and its actions refuse.
MONEY_MOVEMENT=

# Data source for the workspace pages. Server-only. Off unless exactly "on":
# while off, accounts, cash flow and the member come from lib/data seed data,
# so the pages render without the backend or its database.
LIVE_DATA=
